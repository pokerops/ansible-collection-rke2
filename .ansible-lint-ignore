roles/components/defaults/main/argocd.yml var-naming[no-role-prefix]
roles/components/defaults/main/certmanager.yml var-naming[no-role-prefix]
roles/components/defaults/main/cloudflare.yml var-naming[no-role-prefix]
roles/components/defaults/main/longhorn.yml var-naming[no-role-prefix]
roles/components/defaults/main/mariadb.yml var-naming[no-role-prefix]
roles/components/defaults/main/metallb.yml var-naming[no-role-prefix]
roles/components/defaults/main/monitoring.yml var-naming[no-role-prefix]
roles/components/defaults/main/nginx.yml var-naming[no-role-prefix]
roles/components/defaults/main/traefik.yml var-naming[no-role-prefix]
roles/components/tasks/argocd.yml var-naming[no-role-prefix]
roles/components/tasks/certmanager.yml var-naming[no-role-prefix]
roles/components/tasks/logging.yml var-naming[no-role-prefix]
roles/components/tasks/main.yml var-naming[no-role-prefix]
roles/components/tasks/metallb.yml var-naming[no-role-prefix]
roles/components/tasks/nginx.yml var-naming[no-role-prefix]
roles/components/tasks/policies.yml var-naming[no-role-prefix]
roles/components/tasks/traefik.yml var-naming[no-role-prefix]
