{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.3/.schema/devbox.schema.json",
  "include": ["github:pokerops/ansible-utils?dir=devbox/molecule"],
  "env": {
    "CLAUDE_CONFIG_DIR": "$DEVBOX_PROJECT_ROOT/.claude"
  },
  "packages": [
    "libvirt@latest",
    "networkmanager@latest",
    "expect@latest",
    "velero@latest",
    "postgresql@latest",
    "kubernetes-helm@latest",
    "kubectl@latest",
    "skopeo@latest",
    "curl@latest",
    "jq@latest",
    "virt-viewer@latest"
  ]
}
